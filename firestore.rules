rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User accounts: Brand Partners and Direct Customers
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'oriflamearjo@gmail.com');
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'oriflamearjo@gmail.com');
      allow delete: if request.auth != null && request.auth.token.email == 'oriflamearjo@gmail.com';
    }

    // Orders: Customer and Brand Partner purchases for service and dispatch
    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.email == 'oriflamearjo@gmail.com');
      allow create: if true; // Allows checkout order placement even for guest/new customer with their phone/id
      allow update, delete: if request.auth != null && request.auth.token.email == 'oriflamearjo@gmail.com';
    }

    // Clearance Intakes: Submitted by Brand Partners
    match /intakes/{intakeId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.email == 'oriflamearjo@gmail.com');
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.email == 'oriflamearjo@gmail.com';
    }

    // Products: Catalog items (Public Read, Admin Write)
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'oriflamearjo@gmail.com';
    }
  }
}
